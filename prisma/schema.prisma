// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id                    String   @id @default(cuid())
  name                  String
  slug                  String   @unique
  timezone              String   @default("Europe/London")
  currency              String   @default("GBP")
  whatsappSupportNumber String?
  monzoPayUrl           String?
  bankAccountName       String?
  bankSortCode          String?
  bankAccountNumber     String?
  brandingJson          Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  users            User[]
  players          Player[]
  sessions         Session[]
  pricingRules     PricingRule[]
  payments         Payment[]
  auditLogs        AuditLog[]
  playerPointEntries PlayerPointEntry[]
  matches          Match[]

  @@map("organizations")
}

model User {
  id           String    @id @default(cuid())
  orgId        String
  org          Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name         String
  email        String    @unique
  role         UserRole
  passwordHash String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@index([orgId])
  @@map("users")
}

enum UserRole {
  admin
  supervisor
}

model Player {
  id                 String      @id @default(cuid())
  orgId              String
  org                Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  paymentRef         String      @unique
  name               String
  email              String?     @unique
  phone              String?
  pricingRuleId      String?
  pricingRule        PricingRule? @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  isExempt           Boolean     @default(false)
  notes              String?
  isActive           Boolean     @default(true)
  hideFromLeaderboard Boolean   @default(false)
  /// Debt owed before using Hoops Ledger; combined with session fees vs payments (single bucket).
  openingBalancePence Int       @default(0)
  createdAt          DateTime    @default(now())
  updatedAt         DateTime    @updatedAt
  lastLoginAt        DateTime?

  attendance         Attendance[]
  payments           Payment[]
  playerPointEntries PlayerPointEntry[]
  matchPlayers       MatchPlayer[]

  @@index([orgId])
  @@index([orgId, isActive])
  @@index([pricingRuleId])
  @@map("players")
}

model Session {
  id              String        @id @default(cuid())
  orgId           String
  org             Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name            String?
  venue           String?
  startsAt        DateTime
  endsAt          DateTime?
  notes           String?
  pricingRuleId   String?
  pricingRule     PricingRule?  @relation(fields: [pricingRuleId], references: [id], onDelete: SetNull)
  status          SessionStatus @default(scheduled)
  cancelledAt     DateTime?
  cancelledReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  attendance Attendance[]
  payments   Payment[]
  matches    Match[]

  @@index([orgId])
  @@index([orgId, startsAt])
  @@index([startsAt])
  @@index([status])
  @@map("sessions")
}

model Match {
  id                String    @id @default(cuid())
  sessionId         String?
  session           Session?  @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  orgId             String
  org               Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  winningTeam       MatchTeam
  teamATotalPoints  Int       // leaderboard points total for team (used for match win points)
  teamBTotalPoints  Int
  teamAScore        Int?      // optional match score (e.g. 21) for display
  teamBScore        Int?      // optional match score (e.g. 18) for display
  label             String?   // e.g. "Game 1", "Game 2"
  createdAt         DateTime  @default(now())

  matchPlayers      MatchPlayer[]
  playerPointEntries PlayerPointEntry[]

  @@index([sessionId])
  @@index([orgId])
  @@map("matches")
}

enum MatchTeam {
  A
  B
  DRAW
}

model MatchPlayer {
  id        String    @id @default(cuid())
  matchId   String
  match     Match     @relation(fields: [matchId], references: [id], onDelete: Cascade)
  playerId  String
  player    Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
  team      MatchTeam

  @@unique([matchId, playerId])
  @@index([matchId])
  @@index([playerId])
  @@map("match_players")
}

model PlayerPointEntry {
  id        String   @id @default(cuid())
  playerId  String
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  source    String   // e.g. 'match_win'
  amount    Int
  matchId   String?
  match     Match?   @relation(fields: [matchId], references: [id], onDelete: SetNull)
  createdAt DateTime @default(now())

  @@index([playerId])
  @@index([orgId])
  @@index([matchId])
  @@map("player_point_entries")
}

model PricingRule {
  id        String   @id @default(cuid())
  orgId     String
  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  name      String
  feePence  Int      @default(500) // £5.00
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  sessions Session[]
  players  Player[]

  @@index([orgId])
  @@map("pricing_rules")
}

model Attendance {
  id               String           @id @default(cuid())
  sessionId        String
  session          Session          @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  playerId         String
  player           Player           @relation(fields: [playerId], references: [id], onDelete: Cascade)
  checkedInAt      DateTime?
  checkedInByUser  String?
  feeAppliedPence  Int              @default(0)
  status           AttendanceStatus @default(unpaid)
  notes            String?
  paymentId        String?
  payment          Payment?         @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  @@unique([sessionId, playerId])
  @@index([playerId])
  @@index([playerId, status])
  @@index([sessionId])
  @@index([status])
  @@index([paymentId])
  @@index([checkedInAt])
  @@map("attendance")
}

enum AttendanceStatus {
  unpaid
  paid
  waived
  exempt
}

model Payment {
  id          String        @id @default(cuid())
  orgId       String
  org         Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  sessionId   String?
  session     Session?      @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  playerId    String
  player      Player        @relation(fields: [playerId], references: [id], onDelete: Cascade)
  amountPence Int
  method      PaymentMethod
  occurredOn  DateTime
  recordedBy  String?
  notes       String?
  createdAt   DateTime      @default(now())

  attendance Attendance[]

  @@index([orgId])
  @@index([orgId, occurredOn])
  @@index([playerId])
  @@index([sessionId])
  @@index([occurredOn])
  @@map("payments")
}

enum PaymentMethod {
  cash
  bank_transfer
  other
}

enum SessionStatus {
  scheduled
  completed
  cancelled
}

model MagicLink {
  id         String    @id @default(cuid())
  orgId      String
  playerId   String
  email      String
  token      String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([token])
  @@index([playerId])
  @@index([orgId])
  @@map("magic_links")
}

model AuditLog {
  id          String   @id @default(cuid())
  orgId       String
  org         Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  actorUserId String?
  action      String
  entityType  String
  entityId    String
  before      Json?
  after       Json?
  createdAt   DateTime @default(now())

  @@index([orgId])
  @@index([orgId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model SuperAdmin {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  lastLoginAt  DateTime?

  @@map("super_admins")
}